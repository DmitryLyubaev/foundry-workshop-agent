<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0-windows: ContractTests reference Workshop.Surface, and the tests launch the WinForms app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Workshop.Agent\Workshop.Agent.csproj" />
    <!-- For a fresh database to launch the app with. -->
    <ProjectReference Include="..\..\src\Workshop.Core\Workshop.Core.csproj" />
    <!-- For ContractTests and SurfaceClientTests: the server's records to check the client's against, and its session file. -->
    <ProjectReference Include="..\..\src\Workshop.Surface\Workshop.Surface.csproj" />
    <!-- Built first, so AppProcess.FindAppExe finds Workshop.App.exe; nothing of it is referenced. -->
    <ProjectReference Include="..\..\src\Workshop.App\Workshop.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
