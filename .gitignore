# .NET build output
bin/
obj/
*.user
.vs/

# Test output
TestResults/

# Local SQLite databases (every run creates a fresh copy)
*.db
*.db-journal
*.db-wal
*.db-shm

# Terraform (infra/bootstrap, infra/foundry). Values files hold the owner's identifiers; state and
# saved plans hold every resolved value, so each is as sensitive as the other.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/tfplan
infra/**/*.tfplan
infra/**/*.tfvars
infra/**/*.tfvars.json
# Override files are local-only, such as a backend override that keeps state local.
infra/**/override.tf
infra/**/override.tf.json
infra/**/*_override.tf
infra/**/*_override.tf.json
infra/**/crash*.log
# .terraform.lock.hcl is committed on purpose: it pins the providers' exact versions and checksums.

# The evaluation package's local virtual environment and Python caches.
eval/.venv/
__pycache__/
.pytest_cache/
